---
import IconPalette from "@/assets/icons/IconPalette.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

// The picker shows five accent-color families; a light/dark switch flips each
// to its underlying theme. The data-theme value is `${family}-${mode}`.
const families = [
  { key: "sand", label: "Sand" },
  { key: "zinc", label: "Zinc" },
  { key: "rose", label: "Rose" },
  { key: "mint", label: "Mint" },
  { key: "plum", label: "Plum" },
];

// Every reachable theme value, for the hidden <select> that toggle-theme.js drives.
const themeValues = families.flatMap(({ key }) => [`${key}-light`, `${key}-dark`]);
---

{
  SITE.lightAndDarkMode && (
    <div id="theme-picker" class="relative">
      <button
        id="theme-picker-button"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="theme-picker-panel"
        aria-label="Select Theme"
        title="Select Theme"
        class="flex h-9 w-9 items-center justify-center rounded p-2 transition-all hover:text-accent"
      >
        <IconPalette class="h-6 w-6" />
      </button>

      <div
        id="theme-picker-panel"
        class="absolute right-0 top-full z-20 mt-1 hidden min-w-[10rem] rounded border border-border bg-background py-2 text-sm shadow-lg"
      >
        <div class="flex items-center justify-between gap-3 px-3 pb-2">
          <span class="font-medium">Theme</span>
          <button
            id="mode-switch"
            type="button"
            role="switch"
            aria-checked="false"
            aria-label="Switch between light and dark"
            title="Light / dark"
            class="mode-switch"
          >
            <span class="mode-track">
              <span class="mode-thumb" />
              <IconSunHigh class="mode-icon mode-icon-light" aria-hidden="true" />
              <IconMoon class="mode-icon mode-icon-dark" aria-hidden="true" />
            </span>
          </button>
        </div>

        <div class="mx-2 border-t border-border" />

        <ul
          id="theme-picker-list"
          role="listbox"
          aria-label="Accent color"
          class="pt-1"
        >
          {families.map(({ key, label }) => (
            <li
              role="option"
              aria-selected="false"
              data-family={key}
              class="theme-option flex cursor-pointer items-center gap-2 px-3 py-1.5 hover:bg-muted"
            >
              <span class="swatch" aria-hidden="true" />
              <span>{label}</span>
            </li>
          ))}
        </ul>
      </div>

      <select id="theme-selector" class="sr-only" tabindex="-1" aria-hidden="true">
        {themeValues.map(value => (
          <option value={value}>{value}</option>
        ))}
      </select>
    </div>
  )
}

<style>
  /* Drive currentColor (icons) at full theme contrast. */
  #theme-picker {
    color: var(--foreground);
  }

  .theme-option[aria-selected="true"] {
    background: var(--muted);
    color: var(--accent);
  }

  .swatch {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--muted);
  }

  /* Light / dark switch */
  .mode-switch {
    display: inline-flex;
    align-items: center;
  }
  .mode-track {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    place-items: center;
    width: 3.25rem;
    height: 1.55rem;
    padding: 0 0.2rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--muted);
  }
  .mode-thumb {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 2px;
    width: calc(50% - 2px);
    border-radius: 9999px;
    background: var(--background);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    transition: transform 0.18s ease;
  }
  #mode-switch[aria-checked="true"] .mode-thumb {
    transform: translateX(100%);
  }
  .mode-icon {
    position: relative;
    z-index: 1;
    width: 0.95rem;
    height: 0.95rem;
  }
  /* Tint the active side with the accent; the other stays full-contrast. */
  #mode-switch[aria-checked="false"] .mode-icon-light,
  #mode-switch[aria-checked="true"] .mode-icon-dark {
    color: var(--accent);
  }
</style>

<script>
  type Mode = "light" | "dark";
  type Family = "rose" | "zinc" | "mint" | "plum" | "sand";

  // Accent swatch shown for each (family x mode); the corresponding
  // data-theme value is `${family}-${mode}`.
  const ACCENTS: Record<Family, Record<Mode, string>> = {
    rose: { light: "#c43a3f", dark: "#fb7185" },
    zinc: { light: "#006cac", dark: "#8aa6d6" },
    mint: { light: "#3f7a52", dark: "#4ade80" },
    plum: { light: "#6d3fbf", dark: "#b79cf7" },
    sand: { light: "#8f6800", dark: "#e6b64a" },
  };

  function setupThemePicker() {
    const root = document.querySelector<HTMLElement>("#theme-picker");
    if (!root) return;
    const button = root.querySelector<HTMLButtonElement>("#theme-picker-button");
    const panel = root.querySelector<HTMLElement>("#theme-picker-panel");
    const select = root.querySelector<HTMLSelectElement>("#theme-selector");
    const modeSwitch = root.querySelector<HTMLButtonElement>("#mode-switch");
    const options = Array.from(
      root.querySelectorAll<HTMLLIElement>(".theme-option")
    );
    if (!button || !panel || !select || !modeSwitch) return;

    const currentState = (): { family: Family; mode: Mode } => {
      const v = document.documentElement.getAttribute("data-theme") ?? "";
      const [family, mode] = v.split("-");
      if (family in ACCENTS && (mode === "light" || mode === "dark")) {
        return { family: family as Family, mode };
      }
      return { family: "sand", mode: "dark" };
    };

    function render(family: Family, mode: Mode) {
      modeSwitch!.setAttribute(
        "aria-checked",
        mode === "dark" ? "true" : "false"
      );
      for (const opt of options) {
        const fam = (opt.dataset.family ?? "rose") as Family;
        opt.setAttribute("aria-selected", fam === family ? "true" : "false");
        const swatch = opt.querySelector<HTMLElement>(".swatch");
        if (swatch) swatch.style.backgroundColor = ACCENTS[fam][mode];
      }
    }

    function apply(family: Family, mode: Mode) {
      select!.value = `${family}-${mode}`;
      select!.dispatchEvent(new Event("change", { bubbles: true }));
      render(family, mode);
    }

    const syncFromTheme = () => {
      const { family, mode } = currentState();
      render(family, mode);
    };

    function open() {
      syncFromTheme();
      panel!.classList.remove("hidden");
      button!.setAttribute("aria-expanded", "true");
    }
    function close() {
      panel!.classList.add("hidden");
      button!.setAttribute("aria-expanded", "false");
    }
    function toggle() {
      if (panel!.classList.contains("hidden")) open();
      else close();
    }

    button.addEventListener("click", e => {
      e.stopPropagation();
      toggle();
    });

    // Pick a color family, keeping the current light/dark mode.
    for (const opt of options) {
      opt.addEventListener("click", () => {
        const family = (opt.dataset.family ?? "rose") as Family;
        apply(family, currentState().mode);
      });
    }

    // Flip light/dark for the current family.
    modeSwitch.addEventListener("click", e => {
      e.stopPropagation();
      const { family, mode } = currentState();
      apply(family, mode === "dark" ? "light" : "dark");
    });

    document.addEventListener("click", e => {
      if (!root.contains(e.target as Node)) close();
    });
    document.addEventListener("keydown", e => {
      if (e.key === "Escape") close();
    });

    syncFromTheme();
  }

  setupThemePicker();
  document.addEventListener("astro:after-swap", setupThemePicker);
</script>
