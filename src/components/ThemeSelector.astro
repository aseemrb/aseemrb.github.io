---
import IconPalette from "@/assets/icons/IconPalette.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

const themes = [
  { value: "default", label: "Ocean", mode: "light", accent: "#006cac" },
  { value: "sand", label: "Sand", mode: "light", accent: "#b4541e" },
  { value: "sage", label: "Sage", mode: "light", accent: "#3f7a52" },
  { value: "midnight", label: "Midnight", mode: "dark", accent: "#8aa6d6" },
  { value: "forest", label: "Forest", mode: "dark", accent: "#4ade80" },
  { value: "cyber", label: "Grape", mode: "dark", accent: "#a78bfa" },
  { value: "carbon", label: "Coral", mode: "dark", accent: "#fb7185" },
];
---

{
  SITE.lightAndDarkMode && (
    <div id="theme-picker" class="relative">
      <button
        id="theme-picker-button"
        type="button"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="theme-picker-list"
        aria-label="Select Theme"
        title="Select Theme"
        class="flex h-9 w-9 items-center justify-center rounded p-2 transition-all hover:text-accent"
      >
        <IconPalette class="h-6 w-6" />
      </button>
      <ul
        id="theme-picker-list"
        role="listbox"
        aria-label="Select Theme"
        class="absolute right-0 top-full z-20 mt-1 hidden min-w-[8.5rem] overflow-hidden rounded border border-border bg-background py-1 text-sm shadow-lg"
      >
        {themes.map(({ value, label, mode, accent }) => (
          <li
            role="option"
            aria-selected="false"
            data-theme-value={value}
            class="theme-option flex cursor-pointer items-center gap-2 px-3 py-1.5 hover:bg-muted"
          >
            {mode === "dark" ? (
              <IconMoon class="size-4" style={`color:${accent}`} aria-hidden="true" />
            ) : (
              <IconSunHigh class="size-4" style={`color:${accent}`} aria-hidden="true" />
            )}
            <span>{label}</span>
            <span class="sr-only">{mode} theme</span>
          </li>
        ))}
      </ul>
      <select id="theme-selector" class="sr-only" tabindex="-1" aria-hidden="true">
        {themes.map(({ value, label }) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </div>
  )
}

<style>
  .theme-option[aria-selected="true"] {
    background: var(--muted);
    color: var(--accent);
  }
</style>

<script>
  function setupThemePicker() {
    const root = document.querySelector<HTMLElement>("#theme-picker");
    if (!root) return;
    const button = root.querySelector<HTMLButtonElement>("#theme-picker-button");
    const list = root.querySelector<HTMLUListElement>("#theme-picker-list");
    const select = root.querySelector<HTMLSelectElement>("#theme-selector");
    const options = list
      ? Array.from(list.querySelectorAll<HTMLLIElement>(".theme-option"))
      : [];
    if (!button || !list || !select) return;

    function syncActive() {
      const current = select?.value ?? "";
      for (const opt of options) {
        const match = opt.dataset.themeValue === current;
        opt.setAttribute("aria-selected", match ? "true" : "false");
      }
    }

    function open() {
      syncActive();
      list?.classList.remove("hidden");
      button?.setAttribute("aria-expanded", "true");
    }

    function close() {
      list?.classList.add("hidden");
      button?.setAttribute("aria-expanded", "false");
    }

    function toggle() {
      if (list?.classList.contains("hidden")) open();
      else close();
    }

    button.addEventListener("click", e => {
      e.stopPropagation();
      toggle();
    });

    for (const opt of options) {
      opt.addEventListener("click", () => {
        const value = opt.dataset.themeValue ?? "";
        if (!select) return;
        select.value = value;
        select.dispatchEvent(new Event("change", { bubbles: true }));
        syncActive();
        close();
      });
    }

    document.addEventListener("click", e => {
      if (!root) return;
      if (!root.contains(e.target as Node)) close();
    });

    document.addEventListener("keydown", e => {
      if (e.key === "Escape") close();
    });

    syncActive();
  }

  setupThemePicker();
  document.addEventListener("astro:after-swap", setupThemePicker);
</script>
