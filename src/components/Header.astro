---
import Hr from "./Hr.astro";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconArticle from "@/assets/icons/IconArticle.svg";
import IconBooks from "@/assets/icons/IconBooks.svg";
import IconFileCv from "@/assets/icons/IconFileCv.svg";
import IconHome from "@/assets/icons/IconHome.svg";
// Used by the Flights entry, which is commented out below until the page is
// ready to show; restore both together.
// import IconPlane from "@/assets/icons/IconPlane.svg";
import ThemeSelector from "./ThemeSelector.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// Below sm the nav is an icon-only row of equal square tap targets; from sm up
// the icons give way to the text labels.
const navLink =
  "flex h-9 w-9 items-center justify-center font-medium hover:text-accent sm:h-auto sm:w-auto sm:px-2 sm:py-1";
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-center justify-between bg-background px-4 py-4"
    >
      {/* Below sm the title would crowd the icon row, so the home page carries it instead. */}
      <a
        href="/"
        class="hidden items-center whitespace-nowrap font-semibold hover:text-accent sm:flex"
      >
        <span class="text-lg sm:text-xl">{SITE.title}</span>
      </a>
      <nav id="nav-menu" class="flex w-full items-center sm:ms-2 sm:w-auto">
        <ul
          id="menu-items"
          class="flex w-full flex-row items-center justify-center gap-x-5 sm:w-auto sm:justify-end"
        >
          <li class="sm:hidden">
            <a href="/" class:list={[navLink, { "active-nav": isActive("/") }]}>
              <IconHome class="h-6 w-6" aria-hidden="true" />
              <span class="sr-only">Home</span>
            </a>
          </li>
          <li class="ms-auto sm:ms-0">
            <a
              href="/publications"
              class:list={[navLink, { "active-nav": isActive("/publications") }]}
            >
              <IconBooks class="h-6 w-6 sm:hidden" aria-hidden="true" />
              <span class="sr-only sm:not-sr-only">Papers</span>
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class:list={[navLink, { "active-nav": isActive("/blog") }]}
            >
              <IconArticle class="h-6 w-6 sm:hidden" aria-hidden="true" />
              <span class="sr-only sm:not-sr-only">Blog</span>
            </a>
          </li>
          {
            /* Hidden for now; an expression comment rather than an HTML one so
               the link does not ship in the page source.
          <li>
            <a
              href="/logbook"
              class:list={[navLink, { "active-nav": isActive("/logbook") }]}
            >
              <IconPlane class="h-6 w-6 sm:hidden" aria-hidden="true" />
              <span class="sr-only sm:not-sr-only">Flights</span>
            </a>
          </li>
          */
          }
          <li>
            <a
              href="/cv"
              class:list={[navLink, { "active-nav": isActive("/cv") }]}
            >
              <IconFileCv class="h-6 w-6 sm:hidden" aria-hidden="true" />
              <span class="sr-only sm:not-sr-only">CV</span>
            </a>
          </li>
          {
            SITE.showArchives && (
              <li>
                <a
                  href="/archives"
                  class:list={[
                    navLink,
                    "focus-outline",
                    {
                      "active-nav [&>svg]:stroke-accent": isActive("/archives"),
                    },
                  ]}
                >
                  <IconArchive class="h-6 w-6 sm:hidden" aria-hidden="true" />
                  <span class="sr-only sm:not-sr-only">Archives</span>
                </a>
              </li>
            )
          }
          <li class="ms-auto flex items-center sm:ms-0">
            <ThemeSelector />
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>
