---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPath } from "@/utils/getPath";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = getSortedPosts(posts);
const allTags = Array.from(
  new Set(sorted.flatMap(({ data }) => data.tags.map(t => t.toLowerCase())))
).sort();
const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<Layout title={`Blog | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" data-backurl={backUrl}>
    <section class="app-prose mb-28 max-w-app prose-img:border-0">
      <h2>Blog</h2>
      <div class="my-4 flex w-full flex-col gap-3 sm:flex-row">
        <div class="w-full sm:max-w-sm">
          <label for="post-search" class="sr-only">Search posts</label>
          <input
            id="post-search"
            type="search"
            placeholder="search"
            autocomplete="off"
            spellcheck="false"
            class="w-full rounded border border-border bg-background px-3 py-2 font-mono text-sm text-foreground placeholder:opacity-60 focus:border-accent focus:outline-none"
          />
        </div>
        <div class="relative w-full sm:max-w-sm">
          <label for="tag-filter" class="sr-only">Filter by tag</label>
          <input
            id="tag-filter"
            type="search"
            placeholder="filter by tag"
            autocomplete="off"
            spellcheck="false"
            aria-controls="tag-options"
            aria-expanded="false"
            aria-autocomplete="list"
            role="combobox"
            class="w-full rounded border border-border bg-background px-3 py-2 font-mono text-sm text-foreground placeholder:opacity-60 focus:border-accent focus:outline-none"
          />
          <ul
            id="tag-options"
            role="listbox"
            class="absolute left-0 right-0 top-full z-10 mt-1 hidden max-h-64 overflow-auto rounded border border-border bg-background py-1 font-mono text-sm shadow"
          >
            {allTags.map(tag => (
              <li
                role="option"
                data-tag={tag}
                class="cursor-pointer px-3 py-1.5 hover:bg-muted"
              >
                {tag}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p id="tag-empty" class="hidden text-sm opacity-70">No posts match that tag.</p>
      <div id="search-results-wrap" class="hidden">
        <p id="search-status" class="text-sm opacity-70"></p>
        <ul id="search-results" style="padding-left: 0"></ul>
      </div>
      <ul id="post-list" style="padding-left: 0" data-page-size={SITE.postPerPage}>
        {sorted.map(({ id, filePath, data }) => (
          <li
            class="post-item my-6"
            data-tags={data.tags.map(t => t.toLowerCase()).join("|")}
            style="padding-inline-start: 0"
          >
            <h4><LinkButton href={getPath(id, filePath)}>{data.title}</LinkButton></h4>
            <Datetime pubDatetime={data.pubDatetime} timezone={data.timezone} />
            <p>{data.description}</p>
          </li>
        ))}
      </ul>
      <nav
        id="blog-pagination"
        class="mt-8 hidden items-center justify-center"
        aria-label="Pagination"
      >
        <button
          id="page-prev"
          type="button"
          class="group me-4 inline-flex cursor-pointer items-center text-foreground select-none hover:text-accent disabled:cursor-default disabled:text-(--muted-foreground) disabled:hover:text-(--muted-foreground)"
          aria-label="Previous page"
        >
          <IconArrowLeft class="inline-block rtl:rotate-180" />
          Prev
        </button>
        <span id="page-status" class="font-mono text-sm text-foreground"></span>
        <button
          id="page-next"
          type="button"
          class="group ms-4 inline-flex cursor-pointer items-center text-foreground select-none hover:text-accent disabled:cursor-default disabled:text-(--muted-foreground) disabled:hover:text-(--muted-foreground)"
          aria-label="Next page"
        >
          Next
          <IconArrowRight class="inline-block rtl:rotate-180" />
        </button>
      </nav>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>("#tag-filter");
  const dropdown = document.querySelector<HTMLUListElement>("#tag-options");
  const options = dropdown
    ? Array.from(dropdown.querySelectorAll<HTMLLIElement>("li[data-tag]"))
    : [];
  const postList = document.querySelector("#post-list");
  const empty = document.querySelector("#tag-empty");
  const items = postList
    ? Array.from(postList.querySelectorAll<HTMLElement>(".post-item"))
    : [];

  const PAGE_SIZE =
    parseInt((postList as HTMLElement | null)?.dataset.pageSize ?? "", 10) || 10;
  let currentPage = 1;
  const pagination = document.querySelector<HTMLElement>("#blog-pagination");
  const prevBtn = document.querySelector<HTMLButtonElement>("#page-prev");
  const nextBtn = document.querySelector<HTMLButtonElement>("#page-next");
  const status = document.querySelector<HTMLElement>("#page-status");

  function matchedItems(): HTMLElement[] {
    const q = input?.value.trim().toLowerCase() ?? "";
    return items.filter(li => {
      const tags = (li.dataset.tags ?? "").split("|").filter(Boolean);
      return q === "" || tags.some(t => t.includes(q));
    });
  }

  function syncUrl() {
    const params = new URLSearchParams(window.location.search);
    params.delete("q"); // list mode implies no active full-text search
    const q = input?.value.trim().toLowerCase() ?? "";
    if (q) params.set("tag", q);
    else params.delete("tag");
    if (currentPage > 1) params.set("page", String(currentPage));
    else params.delete("page");
    const qs = params.toString();
    history.replaceState(
      null,
      "",
      window.location.pathname + (qs ? `?${qs}` : "")
    );
  }

  function render() {
    // filter across ALL posts, then show the current page of the filtered set
    const matched = matchedItems();
    const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageSet = new Set(matched.slice(start, start + PAGE_SIZE));
    for (const li of items) {
      li.style.display = pageSet.has(li) ? "" : "none";
    }
    if (empty) empty.classList.toggle("hidden", matched.length !== 0);
    if (pagination) {
      pagination.classList.toggle("hidden", totalPages <= 1);
      pagination.classList.toggle("flex", totalPages > 1);
    }
    if (status) status.textContent = `${currentPage} / ${totalPages}`;
    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    syncUrl();
  }

  function applyFilter() {
    currentPage = 1;
    render();
  }

  function goTo(page: number) {
    currentPage = page;
    render();
    postList?.closest("section")?.scrollIntoView({ behavior: "instant", block: "start" });
  }

  prevBtn?.addEventListener("click", () => goTo(currentPage - 1));
  nextBtn?.addEventListener("click", () => goTo(currentPage + 1));

  /* ---------- full-text search (same pagefind index as the old /search page) ---------- */
  const searchInput = document.querySelector<HTMLInputElement>("#post-search");
  const resultsWrap = document.querySelector<HTMLElement>("#search-results-wrap");
  const resultsList = document.querySelector<HTMLElement>("#search-results");
  const searchStatus = document.querySelector<HTMLElement>("#search-status");

  let pagefind: any = null;
  let pagefindFailed = false;
  async function getPagefind() {
    if (pagefind || pagefindFailed) return pagefind;
    try {
      // /pagefind/ lives in /public (synced there by the build script), so it
      // must load as a plain browser import, outside Vite's module graph.
      // A statically analyzable import() gets rewritten by the dev server and
      // fails; this opaque form reaches the browser untouched in dev and prod.
      pagefind = await new Function('return import("/pagefind/pagefind.js")')();
      await pagefind.init();
    } catch {
      pagefind = null;
      pagefindFailed = true;
    }
    return pagefind;
  }

  function setSearchMode(on: boolean) {
    resultsWrap?.classList.toggle("hidden", !on);
    (postList as HTMLElement | null)?.classList.toggle("hidden", on);
    if (on) {
      pagination?.classList.add("hidden");
      pagination?.classList.remove("flex");
      empty?.classList.add("hidden");
    }
  }

  function syncSearchUrl(term: string) {
    const params = new URLSearchParams(window.location.search);
    params.delete("tag");
    params.delete("page");
    if (term) params.set("q", term);
    else params.delete("q");
    const qs = params.toString();
    history.replaceState(
      null,
      "",
      window.location.pathname + (qs ? `?${qs}` : "")
    );
  }

  let searchSeq = 0;
  async function runSearch() {
    const term = searchInput?.value.trim() ?? "";
    const seq = ++searchSeq;
    if (!term) {
      setSearchMode(false);
      render();
      return;
    }
    if (input && input.value !== "") {
      input.value = "";
      currentPage = 1;
    }
    const pf = await getPagefind();
    if (seq !== searchSeq) return;
    if (!pf) {
      if (searchStatus)
        searchStatus.textContent =
          "Search index not found. Run a build once to generate it.";
      if (resultsList) resultsList.innerHTML = "";
      setSearchMode(true);
      syncSearchUrl(term);
      return;
    }
    const res = await pf.debouncedSearch(term);
    if (res === null || seq !== searchSeq) return; // superseded by newer input
    const data = await Promise.all(
      res.results.map((r: any) => r.data())
    );
    if (seq !== searchSeq) return;
    if (resultsList) {
      resultsList.innerHTML = "";
      for (const d of data) {
        const li = document.createElement("li");
        li.className = "my-6";
        li.style.paddingInlineStart = "0";
        const h4 = document.createElement("h4");
        const a = document.createElement("a");
        a.href = d.url;
        a.textContent = (d.meta?.title ?? d.url).split(" | ")[0];
        a.className = "hover:text-accent";
        h4.appendChild(a);
        const p = document.createElement("p");
        p.className = "search-excerpt text-sm";
        p.innerHTML = d.excerpt ?? "";
        li.appendChild(h4);
        li.appendChild(p);
        resultsList.appendChild(li);
      }
    }
    if (searchStatus) {
      const n = res.results.length;
      searchStatus.textContent =
        n === 0
          ? `No results for "${term}".`
          : `${n} result${n === 1 ? "" : "s"} for "${term}"`;
    }
    setSearchMode(true);
    syncSearchUrl(term);
  }

  searchInput?.addEventListener("input", runSearch);

  function refreshDropdown() {
    if (!input || !dropdown) return;
    const q = input.value.trim().toLowerCase();
    let anyVisible = false;
    for (const opt of options) {
      const tag = opt.dataset.tag ?? "";
      const match = q === "" || tag.includes(q);
      opt.style.display = match ? "" : "none";
      if (match) anyVisible = true;
    }
    dropdown.classList.toggle("hidden", !anyVisible);
    input.setAttribute("aria-expanded", anyVisible ? "true" : "false");
  }

  function openDropdown() {
    refreshDropdown();
  }

  function closeDropdown() {
    if (!dropdown || !input) return;
    dropdown.classList.add("hidden");
    input.setAttribute("aria-expanded", "false");
  }

  input?.addEventListener("input", () => {
    // tag filtering and full-text search are mutually exclusive modes
    if (searchInput && searchInput.value !== "") {
      searchInput.value = "";
      searchSeq++;
      setSearchMode(false);
    }
    applyFilter();
    refreshDropdown();
  });
  input?.addEventListener("focus", openDropdown);
  input?.addEventListener("keydown", e => {
    if (e.key === "Escape") closeDropdown();
  });

  for (const opt of options) {
    opt.addEventListener("mousedown", e => {
      e.preventDefault();
      if (!input) return;
      input.value = opt.dataset.tag ?? "";
      applyFilter();
      closeDropdown();
      input.focus();
    });
  }

  document.addEventListener("click", e => {
    const target = e.target as Node;
    if (input?.contains(target) || dropdown?.contains(target)) return;
    closeDropdown();
  });

  const mainContent = document.querySelector("#main-content") as HTMLElement;
  const backUrl = mainContent?.dataset?.backurl;
  if (backUrl) {
    sessionStorage.setItem("backUrl", backUrl);
  }

  // initial state from the URL: /blog?q=... or /blog?tag=...&page=N
  {
    const params = new URLSearchParams(window.location.search);
    const tag = params.get("tag");
    if (tag && input) input.value = tag;
    const page = parseInt(params.get("page") ?? "1", 10);
    if (Number.isFinite(page) && page > 1) currentPage = page;
    render();
    const q = params.get("q");
    if (q && searchInput) {
      searchInput.value = q;
      runSearch();
    }
  }
</script>

<style is:global>
  #search-results .search-excerpt mark {
    background-color: transparent;
    color: var(--accent);
    font-weight: 600;
  }
</style>
