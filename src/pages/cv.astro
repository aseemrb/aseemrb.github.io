---
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconDownload from "@/assets/icons/IconDownload.svg";

---

<Layout title={`CV | ${SITE.title}`}>
  <Header activeNav="cv" />
  <Breadcrumb />
  <main id="main-content">
    <section id="cv" class="mb-14 pt-8">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold">curriculum vitae</h1>
        <LinkButton
            href="/assets/pdf/CV.pdf"
            class="hover:text-accent"
            title="Download PDF"
            target="_blank"
        >
          <div class="flex items-center gap-2">
            <span class="sr-only">Download </span>
            <IconDownload class="size-6" />
            <span>PDF</span>
          </div>
        </LinkButton>
      </div>

      <div class="app-prose max-w-none cv">
        <p class="mt-8 mb-4">See <a href="/publications">here</a> for publications</p>
        <h2 class="text-2xl font-semibold mt-8 mb-4">Experience</h2>
        <ul class="list-disc pl-5">
            <li>
                <span><strong>Scientist</strong>, <a href="https://xtxmarkets.com/">XTX</a></span>
                <span class="cv-date">Jan 2025 - Present</span>
            </li>
            <li>
                <span><strong>Research Intern</strong>, <a href="https://www.microsoft.com/en-us/research">Microsoft</a></span>
                <span class="cv-date">Jun 2023 - Sep 2023</span>
            </li>
            <li>
                <span><strong>Research Intern</strong>, <a href="https://research.google/">Google</a></span>
                <span class="cv-date">Oct 2022 - Dec 2022</span>
            </li>
            <li>
                <span><strong>Software Engineer</strong>, <a href="https://www.microsoft.com/en-us">Microsoft</a></span>
                <span class="cv-date">Jun 2016 - Jul 2018</span>
            </li>
        </ul>

        <Hr />

        <h2 class="text-2xl font-semibold mt-8 mb-4">Education</h2>
        <ul class="list-disc pl-5">
            <li>
                <span><strong>PhD in Computer Science</strong>, <a href="https://uwaterloo.ca/">University of Waterloo</a></span>
                <span class="cv-date">2020 - 2024</span><br />
                Advised by: <a href="https://scholar.google.ca/citations?user=K-SafJUAAAAJ">Kimon Fountoulakis</a> and <a href="https://aukosh.github.io/">Aukosh Jagannath</a>
            </li>
            <li>
                <span><strong>Master of Mathematics in Computer Science</strong>, <a href="https://uwaterloo.ca/">University of Waterloo</a></span>
                <span class="cv-date">2018 - 2020</span><br />
                Advised by: <a href="https://cs.uwaterloo.ca/~shallit/">Jeffrey Shallit</a>
            </li>
            <li>
                <span><strong>Bachelor of Technology in Computer Science</strong>, <a href="https://www.iitj.ac.in/">IIT Jodhpur</a></span>
                <span class="cv-date">2012 - 2016</span>
            </li>
        </ul>

        <Hr />

        <h2 class="text-2xl font-semibold mt-8 mb-4">Awards, Scholarships, and Bursaries</h2>
        <ul class="list-disc pl-5">
            <li>
                <span><strong><a href="https://uwaterloo.ca/computer-science/news/aseem-baranwal-receives-2025-cheriton-distinguished-dissertation-award">Distinguished Dissertation Award</a></strong></span>, <span>University of Waterloo</span>
                <span class="cv-date">2025</span>
            </li>
            <li>
                <span><strong><a href="https://uwaterloo.ca/current-graduate-students/catalogs/graduate-funding-and-awards-database/david-r-cheriton-graduate-scholarships-computer-science">Cheriton Graduate Scholarship</a></strong></span>, <span>University of Waterloo, 10,000 CAD</span>
                <span class="cv-date">2024</span>
            </li>
            <li>
                <span><strong><a href="https://www.edmontonrin.ca/events/upper-bound-2024">Talent bursary</a></strong></span>, <span>Alberta Machine Intelligence Institute</span>
                <span class="cv-date">2024</span>
            </li>
            <li>
                <span><strong><a href="https://log2024.logconference.org/program-committee/#-top-reviewers">Top reviewer award</a></strong></span>, <span>Learning on Graphs conference</span>
                <span class="cv-date">2024</span>
            </li>
            <li>
                <span><strong><a href="https://www.amii.ca/updates-insights/amii-talent-bursary-upperbound2023">Talent bursary</a></strong></span>, <span>Alberta Machine Intelligence Institute</span>
                <span class="cv-date">2023</span>
            </li>
            <li>
                <span><strong><a href="https://uwaterloo.ca/current-graduate-students/awards-and-funding/internal-awards/presidents-graduate-scholarship-pgs">President's Graduate Scholarship</a></strong></span>, <span>University of Waterloo, 10,000 CAD</span>
                <span class="cv-date">2023</span>
            </li>
            <li>
                <span><strong><a href="https://osap.gov.on.ca/OSAPPortal/en/A-ZListofAid/PRDR019245.html">Ontario Graduate Scholarship</a></strong></span>, <span>Province of Ontario + UWaterloo, 15,000 CAD</span>
                <span class="cv-date">2023</span>
            </li>
            <li>
                <span><strong><a href="http://log2022.logconference.org/program-committee/#-top-reviewers">Top reviewer award</a></strong></span>, <span>Learning on Graphs conference</span>
                <span class="cv-date">2022</span>
            </li>
            <li>
                <span><strong><a href="https://sites.google.com/view/groundedml2022/accepted-papers">Best paper award</a></strong></span>, <span>GroundedML workshop at ICLR</span>
                <span class="cv-date">2022</span>
            </li>
            <li>
                <span><strong><a href="https://uwaterloo.ca/math/graduate-research-excellence-award">Graduate Excellence Award</a></strong></span>, <span>Faculty of Math, UWaterloo, 5,000 CAD annually</span>
                <span class="cv-date">2020 -2022</span>
            </li>
        </ul>
        <Hr />

        <h2 class="text-2xl font-semibold mt-8 mb-4">Talks</h2>
        <ul class="list-disc pl-5">
            <li>
                <span>Locally Optimal Message-passing on Feature-decorated Sparse Graphs</span>
                <span class="cv-date">May 2024</span><br />
                <span><a href="https://www.birs.ca/events/2024/5-day-workshops/24w5263/schedule">Banff International Research Station</a>, Canada</span>
            </li>
            <li>
                <span>Optimality of Message-passing Architectures for Sparse Graphs</span>
                <span class="cv-date">Dec 2023</span><br />
                <span><a href="https://neurips.cc/Conferences/2023">Neural Information Processing Systems (NeurIPS)</a>, New Orleans, US</span>
            </li>
            <li>
                <span>Effects of Graph Convolutions in Multi-layer Networks</span>
                <span class="cv-date">Apr 2023</span><br />
                <span><a href="https://iclr.cc/Conferences/2023">International Conference on Learning Representations (ICLR)</a> (virtual talk)</span>
            </li>
            <li>
                <span>Graph Convolutions for semi-supervised learning</span>
                <span class="cv-date">Jul 2021</span><br />
                <span><a href="https://icml.cc/Conferences/2021">International Conference on Machine Learning (ICML)</a> (virtual talk)</span>
            </li>
            <li>
                <span>Repetitions in infinite palindrome-rich words</span>
                <span class="cv-date">Sep 2019</span><br />
                <span><a href="http://www.words2019.lboro.ac.uk/">International Conference on Words</a>, Loughborough University, England</span>
            </li>
            <li>
                <span>Anomaly detection and monitoring of metrics in Azure services</span>
                <span class="cv-date">Jan 2017</span><br />
                <span><a href="https://www.microsoft.com/en-us/">Microsoft Corporation</a></span>
            </li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Dates sit right-aligned next to each entry on wider screens. */
  .cv-date {
    float: right;
  }

  /* On phones a right-floated date makes the entry text wrap around it. Drop the
     float and let the date sit on its own line below the entry instead. */
  @media (max-width: 639px) {
    .cv-date {
      float: none;
      display: block;
      margin-top: 0.15rem;
      font-size: 0.875rem;
      line-height: 1.25;
      opacity: 0.8;
    }

    /* The date already breaks to its own line, so the manual break that some
       entries place right after it would add an empty line. */
    .cv-date + br {
      display: none;
    }
  }
</style>
