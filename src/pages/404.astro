---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import notFoundImage from "@/assets/images/404.gif";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <div
        class="mb-4 bg-contain bg-center bg-no-repeat"
        style={{
          backgroundImage: `url(${notFoundImage.src})`,
          width: `${notFoundImage.width}px`,
          height: `${notFoundImage.height}px`,
          maxWidth: "100%",
        }}
      >
      </div>
      <p class="mt-4 text-2xl sm:text-3xl">Cat got your keyboard?</p>
      <LinkButton
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        Go back home
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
