---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { NEWS } from "@/news";
import dp from "@/assets/images/dp.png";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

dayjs.extend(utc);
dayjs.extend(timezone);
const postDate = (pubDatetime: string | Date, tz: string | undefined) =>
  dayjs(pubDatetime).tz(tz || SITE.timezone);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      {/* Below sm: a profile card, portrait at the left with the name and socials
          stacked beside it. The navbar drops the title at this width, so the
          heading lives here. Desktop keeps the portrait in the row below. */}
      <div class="mt-2 flex items-center justify-center gap-4 sm:hidden">
        <Image
          src={dp}
          alt="Sketch portrait of Aseem Baranwal"
          width={352}
          sizes="160px"
          loading="eager"
          class="min-w-24 max-w-40 flex-1"
        />
        <div class="min-w-0">
          <h1 class="text-xl font-semibold tracking-wide">{SITE.title}</h1>
          {SOCIALS.length > 0 && (
            <div class="mt-2">
              <Socials centered />
            </div>
          )}
        </div>
      </div>
      {/* The header carries the name from sm up, so the heading only needs to
          stay in the document outline there. */}
      <h1 class="sr-only hidden sm:block">{SITE.title}</h1>

      {
        SOCIALS.length > 0 && (
          <div class="hidden sm:my-6 sm:flex sm:flex-row sm:items-center">
            <Socials />
          </div>
        )
      }

      <div class="mt-6 sm:mt-0 sm:flex sm:items-start sm:gap-8">
        <div class="min-w-0 flex-1">
          <p class="mt-2">
            I am a scientist at <LinkButton class="underline-offset-4 hover:text-accent" href="https://xtxmarkets.com/">XTX</LinkButton>.
          </p>
          <p class="mt-2">
            My <LinkButton class="underline-offset-4 hover:text-accent" href="https://uwspace.uwaterloo.ca/items/291d10bc-ba68-4beb-9984-6daa021f6e86">doctorate</LinkButton> focused on statistical foundations for learning on graphs and was co-advised by <LinkButton class="underline-offset-4 hover:text-accent" href="https://scholar.google.ca/citations?user=K-SafJUAAAAJ">Kimon Fountoulakis</LinkButton> and <LinkButton class="underline-offset-4 hover:text-accent" href="https://aukosh.github.io/">Aukosh Jagannath</LinkButton> at the <LinkButton class="underline-offset-4 hover:text-accent" href="https://cs.uwaterloo.ca/">Cheriton School of Computer Science</LinkButton>, <LinkButton class="underline-offset-4 hover:text-accent" href="https://uwaterloo.ca/">University of Waterloo</LinkButton>.
          </p>
          <p class="mt-2">
            Before that, I earned an <LinkButton class="underline-offset-4 hover:text-accent" href="https://uwspace.uwaterloo.ca/items/9b25240e-3e35-4074-8bcf-08a9d7e7c048">M.Math.</LinkButton> at Waterloo, focusing on algorithmic number theory and combinatorics on words, advised by <LinkButton class="underline-offset-4 hover:text-accent" href="https://cs.uwaterloo.ca/~shallit/">Jeffrey Shallit</LinkButton>. My undergrad was at <LinkButton class="underline-offset-4 hover:text-accent" href="http://iitj.ac.in/">IIT Jodhpur</LinkButton>.
          </p>
          <p class="mt-2">
            Fun fact: my <LinkButton class="underline-offset-4 hover:text-accent" href="https://en.wikipedia.org/wiki/Erdős_number">Erdős number</LinkButton> is <a href="https://mathscinet.ams.org/mathscinet/freetools/collab-dist?source=1350148&target=189017">2</a>, via Jeffrey Shallit.
          </p>
        </div>

        <Image
          src={dp}
          alt="Sketch portrait of Aseem Baranwal"
          width={352}
          sizes="176px"
          loading="eager"
          class="mt-2 hidden w-44 shrink-0 sm:block"
        />
      </div>
    </section>

    <Hr />

    {
      NEWS.length > 0 && (
        <>
          <section id="news" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">News</h2>
            <ul class="space-y-4 mt-4">
              {NEWS.map(({ date, content }) => (
                <li class="grid grid-cols-[1fr] md:grid-cols-[auto_1fr] gap-2 md:gap-4 items-baseline">
                  <span class="text-sm text-skin-base opacity-80 font-mono whitespace-nowrap">
                    {date}
                  </span>
                  <span set:html={content} />
                </li>
              ))}
            </ul>
          </section>
          <Hr />
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <>
          <section id="recent-posts" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
            <ul class="mt-4">
              {recentPosts.map(
                ({ id, filePath, data }, index) =>
                  index < SITE.postPerIndex && (
                    <li
                      class="my-3 flex flex-col gap-y-0.5 sm:grid sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-x-4 sm:gap-y-0"
                      style="padding-inline-start: 0"
                    >
                      <LinkButton
                        class="underline-offset-4 hover:text-accent"
                        href={getPath(id, filePath)}
                      >
                        {data.title}
                      </LinkButton>
                      <time
                        class="font-mono text-sm whitespace-nowrap opacity-80 sm:text-right"
                        datetime={postDate(
                          data.pubDatetime,
                          data.timezone
                        ).toISOString()}
                      >
                        {postDate(data.pubDatetime, data.timezone).format(
                          "MMM D, YYYY"
                        )}
                      </time>
                    </li>
                  )
              )}
            </ul>
            <p class="mt-4 text-sm opacity-80">
              <LinkButton class="underline-offset-4 hover:text-accent" href="/blog/">Read more</LinkButton>
            </p>
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset?.layout;
  if (indexLayout) {
    sessionStorage.setItem("backUrl", "/");
  }
</script>
