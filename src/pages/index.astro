---
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { NEWS } from "@/news";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

dayjs.extend(utc);
dayjs.extend(timezone);
const postDate = (pubDatetime: string | Date, tz: string | undefined) =>
  dayjs(pubDatetime).tz(tz || SITE.timezone);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      {
        SOCIALS.length > 0 && (
          <div class="my-4 flex flex-col sm:my-6 sm:flex-row sm:items-center">
            <Socials />
          </div>
        )
      }

      <p class="mt-2">
        I am a scientist at <LinkButton class="underline-offset-4 hover:text-accent" href="https://xtxmarkets.com/">XTX</LinkButton>.
      </p>
      <p class="mt-2">
        My doctorate was on statistical foundations for learning on graphs and high-dimensional probability, co-advised by Prof <LinkButton class="underline-offset-4 hover:text-accent" href="https://scholar.google.ca/citations?user=K-SafJUAAAAJ">Kimon Fountoulakis</LinkButton> and Prof <LinkButton class="underline-offset-4 hover:text-accent" href="https://aukosh.github.io/">Aukosh Jagannath</LinkButton> at the <LinkButton class="underline-offset-4 hover:text-accent" href="https://cs.uwaterloo.ca/">Cheriton School of Computer Science</LinkButton>, <LinkButton class="underline-offset-4 hover:text-accent" href="https://uwaterloo.ca/">University of Waterloo</LinkButton>.
      </p>
      <p class="mt-2">
        Before that, I did my M.Math. at UWaterloo with Prof <LinkButton class="underline-offset-4 hover:text-accent" href="https://cs.uwaterloo.ca/~shallit/">Jeffrey Shallit</LinkButton> on algorithmic number theory and combinatorics on words, and my undergrad at <LinkButton class="underline-offset-4 hover:text-accent" href="http://iitj.ac.in/">IIT Jodhpur</LinkButton>.
      </p>
      <p class="mt-2">
        Fun fact: my <LinkButton class="underline-offset-4 hover:text-accent" href="https://en.wikipedia.org/wiki/Erdős_number">Erdős number</LinkButton> is <a href="https://mathscinet.ams.org/mathscinet/freetools/collab-dist?source=1350148&target=189017">2</a>
        <LinkButton class="underline-offset-4 hover:text-accent" href="http://www.numdam.org/item/JTNB_1991__3_1_43_0/">via</LinkButton>
        Jeffrey Shallit.
      </p>
    </section>

    <Hr />

    {
      NEWS.length > 0 && (
        <>
          <section id="news" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">News</h2>
            <ul class="space-y-4 mt-4">
              {NEWS.map(({ date, content }) => (
                <li class="grid grid-cols-[1fr] md:grid-cols-[auto_1fr] gap-2 md:gap-4 items-baseline">
                  <span class="text-sm text-skin-base opacity-80 font-mono whitespace-nowrap">
                    {date}
                  </span>
                  <span set:html={content} />
                </li>
              ))}
            </ul>
          </section>
          <Hr />
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <>
          <section id="recent-posts" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
            <ul class="mt-4">
              {recentPosts.map(
                ({ id, filePath, data }, index) =>
                  index < SITE.postPerIndex && (
                    <li
                      class="my-3 grid grid-cols-[1fr_auto] items-baseline gap-x-4"
                      style="padding-inline-start: 0"
                    >
                      <LinkButton
                        class="underline-offset-4 hover:text-accent"
                        href={getPath(id, filePath)}
                      >
                        {data.title}
                      </LinkButton>
                      <time
                        class="text-right font-mono text-sm whitespace-nowrap opacity-80"
                        datetime={postDate(
                          data.pubDatetime,
                          data.timezone
                        ).toISOString()}
                      >
                        {postDate(data.pubDatetime, data.timezone).format(
                          "MMM D, YYYY"
                        )}
                      </time>
                    </li>
                  )
              )}
            </ul>
            <p class="mt-4">
              Find all posts <LinkButton class="underline-offset-4 hover:text-accent" href="/blog/">here</LinkButton>.
            </p>
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset?.layout;
  if (indexLayout) {
    sessionStorage.setItem("backUrl", "/");
  }
</script>
