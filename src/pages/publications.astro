---
import PubsLayout from "../layouts/PubsLayout.astro";
import publicationsData from "../data/publications.json";
import coauthorsData from "../data/coauthors.json";
import LinkButton from "@/components/LinkButton.astro";

const publications = [...publicationsData].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

// My own name, emphasized (not linked) in each author list.
const ME = "Aseem";

// Resolve a coauthor's homepage from coauthors.json (keyed by surname).
function coauthorUrl(author: string): string | null {
  const parts = author.split(" ");
  const lastName = parts[parts.length - 1];
  const firstPart = parts.slice(0, -1).join(" ");
  // @ts-ignore - coauthorsData is an untyped JSON map keyed by surname
  const list = coauthorsData[lastName];
  if (!list) return null;
  const match = list.find((e: any) => e.firstname.includes(firstPart));
  return match ? match.url : null;
}

// One restful + hover style for every resource button, defined once.
const chip =
  "inline-flex items-center rounded-md border border-foreground/40 px-3 py-1 text-xs font-medium !text-foreground !no-underline transition-colors duration-150 hover:border-accent hover:!bg-accent hover:!text-background hover:!no-underline";
---

<PubsLayout frontmatter={{ title: "Publications" }}>
  <ul id="pubs" class="not-prose mt-6 divide-y divide-border">
    {
      publications.map(pub => {
        const links: { label: string; href: string }[] = [];
        if (pub.link) links.push({ label: "URL", href: pub.link });
        if (pub.preprint) links.push({ label: "arXiv", href: pub.preprint });
        if (pub.code) links.push({ label: "Code", href: pub.code });
        if (pub.slides) links.push({ label: "Slides", href: pub.slides });
        if (pub.poster) links.push({ label: "Poster", href: pub.poster });
        if (pub.talk) links.push({ label: "Talk", href: pub.talk });
        const titleHref = pub.link || pub.preprint || null;

        return (
          <li class="py-6 first:pt-0">
            <h3 class="text-base font-semibold leading-snug not-italic">
              {titleHref ? (
                <LinkButton href={titleHref}>{pub.title}</LinkButton>
              ) : (
                pub.title
              )}
            </h3>

            {pub.authors.length > 0 && (
              <p class="mt-1.5 text-sm leading-relaxed">
                {pub.authors.map((author, index) => {
                  const isMe = author.includes(ME);
                  const url = coauthorUrl(author);
                  return (
                    <>
                      {isMe ? (
                        <span class="font-semibold">{author}</span>
                      ) : url ? (
                        <LinkButton href={url}>{author}</LinkButton>
                      ) : (
                        <span>{author}</span>
                      )}
                      {index < pub.authors.length - 1 ? ", " : ""}
                    </>
                  );
                })}
              </p>
            )}

            <p class="mt-1 text-sm">
              <span class="italic">{pub.venue}</span>
              <span class="px-1.5">·</span>
              {new Date(pub.date).getFullYear()}
            </p>

            {links.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {links.map(({ label, href }) => (
                  <a href={href} target="_blank" rel="noopener noreferrer" class={chip}>
                    {label}
                  </a>
                ))}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</PubsLayout>
